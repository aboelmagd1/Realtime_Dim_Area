<UserControl x:Class="DimensionOverlay.UI.DimensionSettingsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DimensionOverlay.UI"
             xmlns:models="clr-namespace:DimensionOverlay.Models"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="300">

    <UserControl.Resources>
        <local:EnumEqualsConverter x:Key="EnumEquals"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,4,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">

            <!-- ── Master ON / OFF Switch ─────────────────────── -->
            <GroupBox Header="Tool State (ON / OFF)">
                <StackPanel Margin="2,4">
                    <CheckBox Content="Enable Dynamic Dimensions (ON / OFF)"
                              FontWeight="Bold"
                              FontSize="12"
                              IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Foreground="#666" Margin="0,4,0,0"
                               Text="Check to enable real-time dimensions, uncheck to turn off overlays."/>
                </StackPanel>
            </GroupBox>

            <!-- ── Target Layer ───────────────────────────────── -->
            <GroupBox Header="Target Layer">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Optional: pin the tool to a specific layer.&#x0a;Leave blank to auto-detect from selection."/>
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding Layers}"
                              SelectedItem="{Binding Settings.TargetLayer, Mode=TwoWay}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Service Layers ───────────────────────────── -->
            <GroupBox Header="Service Layers">
                <StackPanel>
                    <CheckBox Content="Apply to Service Layers"
                              IsChecked="{Binding Settings.ApplyToServiceLayers, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Foreground="#666" Margin="0,2,0,0"
                               Text="Allow Dynamic Dimension Overlay to operate on supported ArcGIS service-based layers."/>
                </StackPanel>
            </GroupBox>

            <!-- ── Display Toggles ───────────────────────────── -->
            <GroupBox Header="Show / Hide">
                <StackPanel>
                    <CheckBox Content="Segment lengths"
                              IsChecked="{Binding Settings.ShowSegmentLength, Mode=TwoWay}"/>
                    <CheckBox Content="Polygon area"
                              IsChecked="{Binding Settings.ShowArea, Mode=TwoWay}"/>
                    <CheckBox Content="Perimeter"
                              IsChecked="{Binding Settings.ShowPerimeter, Mode=TwoWay}"/>
                    <CheckBox Content="Vertex angles (between segments)"
                              IsChecked="{Binding Settings.ShowVertexAngles, Mode=TwoWay}"/>
                    <CheckBox Content="Bearing / azimuth per segment"
                              IsChecked="{Binding Settings.ShowBearings, Mode=TwoWay}"/>
                    <CheckBox Content="Area difference (QC)"
                              IsChecked="{Binding Settings.ShowAreaDifference, Mode=TwoWay}"/>
                    <CheckBox Content="Tolerance status (QC)"
                              IsChecked="{Binding Settings.ShowToleranceStatus, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Measurement Method ────────────────────────── -->
            <GroupBox Header="Measurement Method">
                <StackPanel>
                    <RadioButton Content="Automatic" GroupName="Method" Margin="0,3"
                                 IsChecked="{Binding Settings.Method, Converter={StaticResource EnumEquals},
                                             ConverterParameter=Automatic, Mode=TwoWay}"/>
                    <RadioButton Content="Planar (CRS linear units)" GroupName="Method" Margin="0,3"
                                 IsChecked="{Binding Settings.Method, Converter={StaticResource EnumEquals},
                                             ConverterParameter=Planar, Mode=TwoWay}"/>
                    <RadioButton Content="Geodesic (always meters)" GroupName="Method" Margin="0,3"
                                 IsChecked="{Binding Settings.Method, Converter={StaticResource EnumEquals},
                                             ConverterParameter=Geodesic, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Display Units ─────────────────────────────── -->
            <GroupBox Header="Display Units">
                <ComboBox ItemsSource="{Binding Units}"
                          SelectedItem="{Binding Settings.DisplayUnit, Mode=TwoWay}"/>
            </GroupBox>

            <!-- ── Precision & Appearance ────────────────────── -->
            <GroupBox Header="Precision &amp; Appearance">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Decimal places:"/>
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="1"
                            IsSnapToTickEnabled="True" Margin="0,6"
                            Value="{Binding Settings.Precision, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Label offset (px):"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="6" Maximum="40" TickFrequency="2"
                            IsSnapToTickEnabled="True" Margin="0,6"
                            Value="{Binding Settings.OffsetPixels, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Area tolerance %:"/>
                    <Slider Grid.Row="2" Grid.Column="1" Minimum="0.1" Maximum="20" Margin="0,6"
                            Value="{Binding Settings.AreaTolerance, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Style:"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6"
                              ItemsSource="{Binding Styles}"
                              SelectedItem="{Binding Settings.DimensionStyle, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Label}" Text="Text Color:"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,6"
                              ItemsSource="{Binding TextColors}"
                              SelectedItem="{Binding Settings.TextColor, Mode=TwoWay}"/>
                </Grid>
            </GroupBox>

            <!-- ── Live Status ───────────────────────────────── -->
            <GroupBox Header="Live Status (read-only)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="CRS:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4"
                               Text="{Binding Settings.CrsName}" TextWrapping="Wrap" FontWeight="Bold"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="WKID:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4"
                               Text="{Binding Settings.Wkid}" FontWeight="Bold"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Method:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4"
                               Text="{Binding Settings.ResolvedMethod}" FontWeight="Bold"/>
                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
