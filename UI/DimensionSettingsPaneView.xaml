<UserControl x:Class="GeoMetrics.UI.DimensionSettingsPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GeoMetrics.UI"
             xmlns:models="clr-namespace:GeoMetrics.Models"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="300"
             TextElement.Foreground="{DynamicResource Esri_TextPrimaryBrush}"
             TextElement.FontSize="11.5"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <local:EnumEqualsConverter x:Key="EnumEquals"/>

        <!-- High-contrast text brushes: Black in Light Mode, dynamically flipped to White in Dark Mode -->
        <SolidColorBrush x:Key="Esri_TextPrimaryBrush" Color="#000000"/>
        <SolidColorBrush x:Key="Esri_TextSecondaryBrush" Color="#555555"/>

        <!-- Dedicated Dropdown Theme Brushes (Black in Light Mode, White in Dark Mode) -->
        <SolidColorBrush x:Key="DropdownTextBrush" Color="#000000"/>
        <SolidColorBrush x:Key="DropdownBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="DropdownHighlightBrush" Color="#E5F1FB"/>
        <SolidColorBrush x:Key="DropdownBorderBrush" Color="#B8B8B8"/>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="TemplateRoot"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">
                <Border x:Name="SplitBorder"
                        Width="20"
                        HorizontalAlignment="Right"
                        SnapsToDevicePixels="True">
                    <Path x:Name="Arrow"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z"
                          Fill="{DynamicResource DropdownTextBrush}"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="#888888"/>
                    <Setter TargetName="TemplateRoot" Property="Background" Value="{DynamicResource DropdownHighlightBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Global ComboBox Style: dark background, white text, styled popup -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource DropdownTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DropdownBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DropdownBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Focusable="False"/>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DropdownTextBrush}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource DropdownBackgroundBrush}"
                                        BorderBrush="{DynamicResource DropdownBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True"
                                        Margin="0,1,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.56"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource DropdownTextBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource DropdownBackgroundBrush}"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          VerticalAlignment="Center">
                                            <ContentPresenter.Resources>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource DropdownTextBrush}"/>
                                                </Style>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource DropdownHighlightBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#007ACC"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource DropdownTextBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource DropdownTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DropdownBackgroundBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Esri_TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,4,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Esri_TextPrimaryBrush}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Margin" Value="0,3,0,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Esri_TextSecondaryBrush}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueText">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Esri_TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" TextElement.Foreground="{DynamicResource Esri_TextPrimaryBrush}">

            <!-- ── Master ON / OFF Switch ─────────────────────── -->
            <GroupBox Header="Tool State (ON / OFF)">
                <StackPanel Margin="2,4">
                    <CheckBox Content="Enable GeoMetrics (ON / OFF)"
                              FontWeight="Bold"
                              FontSize="12"
                              IsChecked="{Binding Settings.IsEnabled, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Check to enable GeoMetrics, uncheck to turn off overlays."/>
                </StackPanel>
            </GroupBox>

            <!-- ── Target Layer ───────────────────────────────── -->
            <GroupBox Header="Target Layer">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Optional: pin the tool to a specific layer.&#x0a;Leave blank to auto-detect from selection."/>
                    <ComboBox Margin="0,4,0,0"
                              ItemsSource="{Binding Layers}"
                              SelectedItem="{Binding Settings.TargetLayer, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource DropdownTextBrush}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- ── Multi-Feature Selection ───────────────────────── -->
            <GroupBox Header="Multi-Feature Selection">
                <StackPanel>
                    <CheckBox Content="Enable multi-feature measurements"
                              FontWeight="SemiBold"
                              IsChecked="{Binding Settings.MultiFeatureEnabled, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Measure and annotate all selected features simultaneously instead of only the first feature."/>

                    <DockPanel Margin="0,5,0,2" LastChildFill="True" IsEnabled="{Binding Settings.MultiFeatureEnabled}">
                        <TextBlock Text="Max features limit:"
                                   Style="{StaticResource Label}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <ComboBox Width="65"
                                  Height="22"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding MaxFeaturesLimitList}"
                                  SelectedItem="{Binding Settings.MaxFeaturesLimit, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource DropdownTextBrush}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>

                    <CheckBox Margin="0,6,0,0"
                              Content="Place polygon dimensions inside"
                              IsChecked="{Binding Settings.MultiFeaturePolygonInside, Mode=TwoWay}"
                              IsEnabled="{Binding Settings.MultiFeatureEnabled}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Margin="18,0,0,2"
                               Text="Draws dimensions inside polygon boundaries to prevent overlaps between adjacent features."/>
                </StackPanel>
            </GroupBox>

            <!-- ── Service Layers ───────────────────────────── -->
            <GroupBox Header="Service Layers">
                <StackPanel>
                    <CheckBox Content="Apply to Service Layers"
                              IsChecked="{Binding Settings.ApplyToServiceLayers, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Allow GeoMetrics to operate on supported ArcGIS service-based layers."/>
                </StackPanel>
            </GroupBox>

            <!-- ── Display Toggles ───────────────────────────── -->
            <GroupBox Header="Show / Hide">
                <StackPanel>
                    <CheckBox Content="Segment lengths"
                              IsChecked="{Binding Settings.ShowSegmentLength, Mode=TwoWay}"/>
                    <CheckBox Content="Polygon area"
                              IsChecked="{Binding Settings.ShowArea, Mode=TwoWay}"/>
                    <CheckBox Content="Perimeter"
                              IsChecked="{Binding Settings.ShowPerimeter, Mode=TwoWay}"/>
                    <CheckBox Content="Vertex angles (between segments)"
                              IsChecked="{Binding Settings.ShowVertexAngles, Mode=TwoWay}"/>

                    <!-- Vertex Coordinates with Decimal Digits Selector (Default: 4) -->
                    <DockPanel Margin="0,3" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Decimals:"
                                       FontSize="11"
                                       Margin="6,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Esri_TextSecondaryBrush}"
                                       IsEnabled="{Binding Settings.ShowVertexCoordinates}"/>
                            <ComboBox Width="46"
                                      Height="22"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding CoordinatePrecisionList}"
                                      SelectedItem="{Binding Settings.CoordinatePrecision, Mode=TwoWay}"
                                      IsEnabled="{Binding Settings.ShowVertexCoordinates}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource DropdownTextBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox Content="Vertex coordinates (X, Y)"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.ShowVertexCoordinates, Mode=TwoWay}"/>
                    </DockPanel>

                    <!-- Area Difference Before & During Edit -->
                    <CheckBox Content="Area difference (before &amp; after edit)"
                              IsChecked="{Binding Settings.ShowAreaDifference, Mode=TwoWay}"/>

                    <!-- Viewport HUD (Visible Vertices & Segments Count) -->
                    <CheckBox Content="Visible vertices &amp; segments count (HUD)"
                              IsChecked="{Binding Settings.ShowViewportHud, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Margin="18,0,0,4"
                               Text="Displays live count of visible vertices and segments at viewport top-left (Default: OFF)."/>

                    <!-- Hidden Dimensions Warning at Viewport Top-Right -->
                    <CheckBox Content="Hidden dimensions warning (top-right)"
                              IsChecked="{Binding Settings.ShowHiddenDimensionsWarning, Mode=TwoWay}"/>
                    <TextBlock Style="{StaticResource Hint}"
                               Margin="18,0,0,4"
                               Text="Displays a warning at top-right when some segments are hidden due to zoom level or short length."/>
                </StackPanel>
            </GroupBox>

            <!-- ── Measurement Method ────────────────────────── -->
            <GroupBox Header="Measurement Method">
                <StackPanel>
                    <RadioButton Content="Automatic" GroupName="Method" Margin="0,3"
                                 IsChecked="{Binding Settings.Method, Converter={StaticResource EnumEquals},
                                             ConverterParameter=Automatic, Mode=TwoWay}"/>
                    <RadioButton Content="Planar (CRS linear units)" GroupName="Method" Margin="0,3"
                                 IsChecked="{Binding Settings.Method, Converter={StaticResource EnumEquals},
                                             ConverterParameter=Planar, Mode=TwoWay}"/>
                    <RadioButton Content="Geodesic (always meters)" GroupName="Method" Margin="0,3"
                                 IsChecked="{Binding Settings.Method, Converter={StaticResource EnumEquals},
                                             ConverterParameter=Geodesic, Mode=TwoWay}"/>
                </StackPanel>
            </GroupBox>

            <!-- ── Display Units ─────────────────────────────── -->
            <GroupBox Header="Display Units">
                <ComboBox ItemsSource="{Binding Units}"
                          SelectedItem="{Binding Settings.DisplayUnit, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource DropdownTextBrush}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </GroupBox>

            <!-- ── Precision & Appearance ────────────────────── -->
            <GroupBox Header="Precision &amp; Appearance">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="Decimal places:"/>
                    <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="4" TickFrequency="1"
                            IsSnapToTickEnabled="True" Margin="0,6"
                            Value="{Binding Settings.Precision, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="Label offset (px):"/>
                    <Slider Grid.Row="1" Grid.Column="1" Minimum="6" Maximum="40" TickFrequency="2"
                            IsSnapToTickEnabled="True" Margin="0,6"
                            Value="{Binding Settings.OffsetPixels, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Style:"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6"
                              ItemsSource="{Binding Styles}"
                              SelectedItem="{Binding Settings.DimensionStyle, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource DropdownTextBrush}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Label}" Text="Text Color:"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6"
                              ItemsSource="{Binding TextColors}"
                              SelectedItem="{Binding Settings.TextColor, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource DropdownTextBrush}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <!-- ── Live Status ───────────────────────────────── -->
            <GroupBox Header="Live Status (read-only)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Label}" Text="CRS:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueText}"
                               Text="{Binding Settings.CrsName}" TextWrapping="Wrap"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Label}" Text="WKID:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueText}"
                               Text="{Binding Settings.Wkid}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Label}" Text="Method:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueText}"
                               Text="{Binding Settings.ResolvedMethod}"/>
                </Grid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
