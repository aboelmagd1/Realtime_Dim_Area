<?xml version="1.0" encoding="utf-8"?>
<ArcGIS defaultAssembly="DimensionOverlay.dll" defaultNamespace="DimensionOverlay"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry http://Config.xsd">

  <AddInInfo id="{9B2F1B6E-3B9F-4B7F-9E7B-D1F1E3A2C001}" version="2.0.0" desktopVersion="3.0">
    <Name>Dynamic Dimension Overlay</Name>
    <Description>
      Passive real-time CAD-style dimension monitor.
      Works on top of ArcGIS Pro's native Edit → Modify workflow.
      Does NOT replace or interfere with native editing tools.
    </Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>Aboelmagd</Author>
    <Company>Al-Qotr Co.</Company>
    <Date>8/24/2026</Date>
    <Subject>Editing, Geometry, Visualization</Subject>
  </AddInInfo>

  <modules>
    <insertModule id="DimensionOverlay_Module" className="Module1" autoLoad="true"
                  caption="Dynamic Dimension Overlay Module">

      <controls>

        <!-- Primary Ribbon Toggle Button for Dynamic Dimensions ON / OFF -->
        <button id="DimensionOverlay_ToggleDimensions"
                caption="Dynamic Dimensions"
                className="UI.DimensionToggleButton"
                loadOnClick="false"
                keytip="D"
                smallImage="Images\GenericButtonRed16.png"
                largeImage="Images\GenericButtonRed32.png">
          <tooltip heading="Dynamic Dimensions (ON / OFF)">
            Toggle real-time dimension monitoring ON or OFF.
            When ON: segment lengths and area update live during editing and selection.
            Does NOT interfere with native Modify or Edit Vertices tools.
            <disabledText/>
          </tooltip>
        </button>

        <!-- Settings pane button -->
        <button id="DimensionOverlay_ShowSettingsPane_Button"
                caption="Settings"
                className="UI.ShowSettingsButton"
                loadOnClick="true"
                keytip="S"
                smallImage="Images\GenericButtonBlue16.png"
                largeImage="Images\GenericButtonBlue32.png">
          <tooltip heading="Dimension Settings">
            Open the Dimension Overlay settings pane
            (units, method, display options, precision).
            <disabledText/>
          </tooltip>
        </button>

      </controls>

      <dockPanes>
        <dockPane id="DimensionOverlay_UI_DimensionSettingsPane"
                  caption="Dimension Overlay Settings"
                  className="UI.DimensionSettingsPaneViewModel"
                  dock="right">
          <content className="UI.DimensionSettingsPaneView"/>
        </dockPane>
      </dockPanes>

      <groups>
        <group id="DimensionOverlay_Group1" caption="Dynamic Dimension Overlay"
               appearsOnAddInTab="true">
          <button refID="DimensionOverlay_ToggleDimensions" size="large"/>
          <button refID="DimensionOverlay_ShowSettingsPane_Button" size="large"/>
        </group>
      </groups>

      <tabs>
        <tab id="DimensionOverlay_Tab1" caption="Dimension Overlay">
          <group refID="DimensionOverlay_Group1"/>
        </tab>
      </tabs>

    </insertModule>
  </modules>
</ArcGIS>
