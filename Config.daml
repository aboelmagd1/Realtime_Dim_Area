<?xml version="1.0" encoding="utf-8"?>
<ArcGIS defaultAssembly="GeoMetrics.dll" defaultNamespace="GeoMetrics"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://schemas.esri.com/DADF/Registry http://Config.xsd">

  <AddInInfo id="{9B2F1B6E-3B9F-4B7F-9E7B-D1F1E3A2C001}" version="2.0.0" desktopVersion="3.0">
    <Name>GeoMetrics</Name>
    <Description>
      GeoMetrics is an ArcGIS Pro Add-in for real-time geometry measurements, including segment lengths, area, perimeter, and other geometry information during feature selection and editing.
    </Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>Aboelmagd</Author>
    <Company>Al-Qotr Co.</Company>
    <Date>8/24/2026</Date>
    <Subject>Editing, Geometry, Visualization</Subject>
  </AddInInfo>

  <modules>
    <insertModule id="GeoMetrics_Module" className="Module1" autoLoad="true"
                  caption="GeoMetrics Module">

      <controls>

        <!-- Primary Ribbon Toggle Button for GeoMetrics ON / OFF -->
        <button id="GeoMetrics_ToggleDimensions"
                caption="GeoMetrics"
                className="UI.DimensionToggleButton"
                loadOnClick="false"
                keytip="D"
                smallImage="Images\GeoMetricsToggle_OFF_16.png"
                largeImage="Images\GeoMetricsToggle_OFF_32.png">
          <tooltip heading="GeoMetrics (ON / OFF)">
            Toggle real-time geometry measurements ON or OFF.
            When ON: segment lengths and area update live during editing and selection.
            Does NOT interfere with native Modify or Edit Vertices tools.
            <disabledText/>
          </tooltip>
        </button>

        <!-- Settings pane button -->
        <button id="GeoMetrics_ShowSettingsPane_Button"
                caption="Settings"
                className="UI.ShowSettingsButton"
                loadOnClick="true"
                keytip="S"
                smallImage="Images\GeoMetricsSettings_16.png"
                largeImage="Images\GeoMetricsSettings_32.png">
          <tooltip heading="GeoMetrics Settings">
            Open the GeoMetrics settings pane
            (units, method, display options, precision).
            <disabledText/>
          </tooltip>
        </button>

      </controls>

      <dockPanes>
        <dockPane id="GeoMetrics_UI_DimensionSettingsPane"
                  caption="GeoMetrics Settings"
                  className="UI.DimensionSettingsPaneViewModel"
                  dock="right">
          <content className="UI.DimensionSettingsPaneView"/>
        </dockPane>
      </dockPanes>

      <groups>
        <group id="GeoMetrics_Group1" caption="GeoMetrics"
               appearsOnAddInTab="false">
          <button refID="GeoMetrics_ToggleDimensions" size="large"/>
          <button refID="GeoMetrics_ShowSettingsPane_Button" size="large"/>
        </group>
      </groups>

      <tabs>
        <tab id="GeoMetrics_Tab1" caption="GeoMetrics">
          <group refID="GeoMetrics_Group1"/>
        </tab>
      </tabs>

    </insertModule>
  </modules>
</ArcGIS>
