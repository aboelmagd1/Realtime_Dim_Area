# ====================================================================
# .gitignore for ArcGIS Pro .NET Add-in (C# / .NET 8 / Visual Studio)
# ====================================================================

# ── Build Outputs & Intermediate Compilation Folders ───────────────
obj/
[Oo]bj/
bin/
[Bb]in/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]uild/
out/
[Tt]est[Rr]esults/
esri_addin_staging/
Generated Files/
*_wpftmp.csproj
*.FileListAbsolute.txt

# ── Allow Pre-built Release Package Only ───────────────────────────
!Addin_Package/
!Addin_Package/**
!Addin_Package/*.esriAddinX

# ── Backups, Drafts & Copy Folders ─────────────────────────────────
* - Copy/
* - Copy*/
draft/
draft/**
backup/
Backup/
backups/
Backups/
scratch/
temp/
Temp/
tmp/
Tmp/
*.bak
*.old
*.orig
*.zip

# ── Visual Studio, Rider & IDE Caches ──────────────────────────────
.vs/
.vscode/
.idea/
_ReSharper*/
*.DotSettings.user
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.launch
*.VC.db
*.opendb
*.pidb
*.booproj
*.svclog

# ── NuGet & Package Caches ─────────────────────────────────────────
packages/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# ── Logs & Crash Dumps ─────────────────────────────────────────────
*.log
*.tlog
*.dmp
*.stackdump

# ── OS Generated Files ─────────────────────────────────────────────
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── ArcGIS Pro & Geodatabase Temporary Files ───────────────────────
*.esriAddinX.zip
*.aprx.bak
*.gdb.lock
*.geodatabase-shm
*.geodatabase-wal
